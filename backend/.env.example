PORT=3000
# F16: origen institucional HTTPS en producción; adaptador de correo todavía no configurado.
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgresql_password
DB_NAME=ecoamigos

# S01: apply database/20260914_s01_session_version.sql before starting the updated API.
# S02: Bearer only; exact frontend origins, no cookies/credentials. Production remains to be defined.
CORS_ORIGINS=http://localhost:5173
# S03: trusted reverse-proxy IPs/subnets only; empty means direct connection.
TRUSTED_PROXIES=
AUTH_WINDOW_MS=900000
AUTH_LOGIN_MAX=10
AUTH_FORGOT_MAX=5
AUTH_RESET_MAX=10

# S04-S07: all uploads are outside static serving; legacy paths resolve under this root.
# Relative to backend working directory. Set an absolute path in deployment.
UPLOAD_ROOT=uploads
UPLOAD_IMAGE_MB=10
UPLOAD_DOCUMENT_MB=20
UPLOAD_VIDEO_MB=100
UPLOAD_EVIDENCE_MB=20
