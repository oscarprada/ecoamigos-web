PORT=3000
# F16/S08: un único origen frontend; también fallback CORS. Sin dominio institucional elegido.
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgresql_password
DB_NAME=ecoamigos
# URL no vacía prevalece sobre DB_HOST/PORT/USER/PASSWORD/NAME. Sin parámetros query.
DATABASE_URL=
# true exige certificado válido; no se desactiva su verificación.
DB_SSL=false

# S01: apply database/20260914_s01_session_version.sql before starting the updated API.
# S02: Bearer only; exact frontend origins, no cookies/credentials. Production remains to be defined.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Omitir para usar CLIENT_URL. Si se define vacía/inválida, el inicio falla.
# S03: trusted reverse-proxy IPs/subnets only; empty means direct connection.
TRUSTED_PROXIES=
AUTH_WINDOW_MS=900000
AUTH_LOGIN_MAX=10
AUTH_FORGOT_MAX=5
AUTH_RESET_MAX=10

# S04-S07: all uploads are outside static serving; legacy paths resolve under this root.
# Relative to backend working directory. Set an absolute path in deployment.
UPLOAD_ROOT=uploads
UPLOAD_IMAGE_MB=10
UPLOAD_DOCUMENT_MB=20
UPLOAD_VIDEO_MB=100
UPLOAD_EVIDENCE_MB=20

# S10: defaults técnicos ajustables; no política de retención institucional.
LOG_DIR=logs
LOG_MAX_BYTES=5242880
# Cantidad de archivos rotados, además del actual.
LOG_MAX_FILES=5
LOG_QUEUE_LIMIT=1000

# S11: límite técnico por reporte (1..10000), no política institucional.
EXPORT_MAX_ROWS=1000
