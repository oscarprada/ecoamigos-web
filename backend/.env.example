PORT=3000
NODE_ENV=development
# F16/S08: un único origen frontend para CORS/CSRF y recuperación. Sin dominio institucional elegido.
CLIENT_URL=http://localhost:5173
# Sin valor predeterminado: configurar un secreto aleatorio privado antes de arrancar.
# En producción se requieren al menos 32 bytes; nunca reutilizar valores de ejemplo.
JWT_SECRET=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgresql_password
DB_NAME=ecoamigos
# URL no vacía prevalece sobre DB_HOST/PORT/USER/PASSWORD/NAME.
# Producción/Neon: configurar DATABASE_URL en el proveedor, NODE_ENV=production,
# DB_SSL=true y CLIENT_URL=https://frontend.example.invalid (sustituir por el origen real).
# Ejemplo ficticio, NO utilizable: postgresql://example_user:REPLACE_PRIVATE_PASSWORD@db.example.invalid/ecoamigos?sslmode=require&channel_binding=require
# Solo se admiten sslmode=require o verify-full, y channel_binding=require.
# No combinar esos parámetros con DB_SSL=false. Otros parámetros se rechazan.
DATABASE_URL=
# true exige certificado válido; no se desactiva su verificación.
# Si se omite: true en producción o con parámetros TLS de URL; false en desarrollo local.
DB_SSL=false

# S01: apply database/20260914_s01_session_version.sql before starting the updated API.
# S02: HttpOnly cookie, SameSite=Lax, Path=/api, 8h; Secure in production.
# Frontend/API must be same-site; production requires HTTPS.
# CLIENT_URL is the sole CORS/CSRF origin. Remove legacy CORS_ORIGINS,
# or keep it identical to CLIENT_URL; a different value fails startup.
# S03: trusted reverse-proxy IPs/subnets only; empty means direct connection.
TRUSTED_PROXIES=
AUTH_WINDOW_MS=900000
AUTH_LOGIN_MAX=10
AUTH_FORGOT_MAX=5
AUTH_RESET_MAX=10

# S04-S07: all uploads are outside static serving; legacy paths resolve under this root.
# Relative to backend working directory. Set an absolute path in deployment.
UPLOAD_ROOT=uploads
UPLOAD_IMAGE_MB=10
UPLOAD_DOCUMENT_MB=20
UPLOAD_VIDEO_MB=100
UPLOAD_EVIDENCE_MB=20

# S10: defaults técnicos ajustables; no política de retención institucional.
LOG_DIR=logs
LOG_MAX_BYTES=5242880
# Cantidad de archivos rotados, además del actual.
LOG_MAX_FILES=5
LOG_QUEUE_LIMIT=1000

# S11: límite técnico por reporte (1..10000), no política institucional.
EXPORT_MAX_ROWS=1000

# NODE_ENV: development para uso local; production exige origen CORS explícito
# y HTTPS para enlaces F16. El despliegue institucional no está realizado.
# ECOAMIGOS_TEST_PG_BIN pertenece solo al runner de pruebas, no a la conexión de aplicación.
# GET /api/health devuelve {"status":"ok"}; comprueba el proceso, no la disponibilidad de BD.
# Node.js: usar la versión 24.x indicada en package.json (CI: 24.13.0).
